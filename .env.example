PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_saas?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

# Super Admin seed credentials (used only by npm run seed)
SUPER_ADMIN_EMAIL=superadmin@foodsaas.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
